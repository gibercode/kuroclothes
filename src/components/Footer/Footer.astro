---
import styles from "./style.module.scss";
---

<script>
  const elements: HTMLCollectionOf<HTMLParagraphElement> =
    document.getElementsByTagName("p");
  Array.from(elements).forEach((element: HTMLParagraphElement) => {
    element.addEventListener("click", (event: Event) => {
      const target = event.target as HTMLElement;
      const elementToOpen = `${target.id}-accordion`;
      const accordionElement = document.querySelector<HTMLElement>(
        `#${elementToOpen}`
      );

      if (accordionElement) {
        if (
          !accordionElement.style.display ||
          accordionElement.style.display === "none"
        ) {
          accordionElement.style.display = "block";
        } else {
          accordionElement.style.display = "none";
        }
      }
    });
  });
</script>

<footer class={styles.main} id="footer">
  <div>
    <p class:list={styles.text} id="payment">Métodos de pago +</p>
    <div class={styles.accordion} id="payment-accordion">
      <ul>
        <li>- Binance</li>
        <li>- Pipol pay</li>
        <li>- Pago móvil</li>
        <li>- Airtm</li>
        <li>- Zinli</li>
        <li>- Efectivo</li>
      </ul>
    </div>
    <p class={styles.text} id="send">Envíos +</p>
    <div class={styles.accordion} id="send-accordion">
      <ul>
        <li>
          Envíos a nivel nacional a través de MRW y Zoom (Cobro a destino)
        </li>
      </ul>
    </div>
    <p class={styles.text} id="terms">Términos y condiciones +</p>
    <div class={styles.accordion} id="terms-accordion">
      <ul>
        <li>- Los productos están sujetos a disponibilidad.</li>
        <li>- No realizamos devoluciones ni reembolsos.</li>
        <li>
          - No nos hacemos responsables por daños causados por la empresa de
          envío.
        </li>
        <li>
          - Los pedidos personalizados deben solicitarse con 5 días hábiles de
          anticipación.
        </li>
        <li>
          - Los pedidos personalizados debe abonar 50% del costo del producto al
          ser solicitado.
        </li>
      </ul>
    </div>
  </div>
  <div class={styles.media}>
    <a
      href="https://www.tiktok.com/@kuroclothes.ve"
      target="_blank"
      rel="noopener"
    >
      <img
        src="/tik-tok.png"
        alt="tik tok"
        width={30}
        class:list={[styles.icon, styles.separation]}
        loading="lazy"
        decoding="async"
      />
    </a>
    <a
      href="https://www.instagram.com/kuroclothes.ve/"
      target="_blank"
      rel="noopener"
    >
      <img
        src="/instagram.png"
        alt="instagram"
        width={30}
        class:list={[styles.icon, styles.separation]}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</footer>
